<!doctype html>
<html lang="ko">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= item.title %> - 주얼리 쇼케이스</title>
  <link rel="stylesheet" href="/public/style.css">
</head>
<body class="item-page">
  <header class="detail-header">
    <nav>
      <div class="brand">DOUBLE-ONE JEWELRY</div>

    </nav>
  </header>

  <main class="shop-detail-wrap">
    <nav class="breadcrumb-nav">
      <a href="/">HOME</a>
      <span>›</span>
      <a href="/#category-filter">전체상품</a>
      <span>›</span>
      <a href="/?category=<%= encodeURIComponent(item.category) %>#category-filter"><%= item.category %></a>
      <span>›</span>
      <a href="/?category=<%= encodeURIComponent(item.category) %>&brand=<%= encodeURIComponent(item.brand || '전체') %>#category-filter"><%= item.brand || '브랜드 없음' %></a>
    </nav>
    <section class="shop-product-head">
      <div class="shop-cover-box">
        <img src="<%= item.coverImage || item.image %>" alt="<%= item.title %>">
      </div>
      <div class="shop-info-box">
        <h1><%= item.title %></h1>
        <div class="shop-info-table">
          <div><span>판매가</span><strong>문의</strong></div>
          <div><span>카테고리</span><strong><%= item.category %></strong></div>
          <div><span>브랜드</span><strong><%= item.brand || '브랜드 없음' %></strong></div>
        </div>
        <a class="kakao-button" href="/item/1778035383224">카톡문의</a>
      </div>
    </section>

    <section class="shop-tab-title">
      <span>상품 정보</span>
    </section>

    <section class="shop-description">
      <h2>상품 상세설명</h2>
      <% if (item.description) { %>
        <p><%= item.description %></p>
      <% } %>
      <img class="shop-detail-image" src="<%= item.coverImage || item.image %>" alt="<%= item.title %> 대표 이미지">
      <% (item.detailImages || []).forEach(detailImage => { %>
        <img class="shop-detail-image" src="<%= detailImage %>" alt="<%= item.title %> 상세 이미지">
      <% }) %>
    </section>
  </main>

  <footer class="contact-footer">
    <div class="contact-main">
      <img class="kakao-icon" src="/public/kakaotalk.svg" alt="KakaoTalk">
      <a href="/item/1778035383224">카톡문의</a>
    </div>
    <a class="customs-link" href="https://unipass.customs.go.kr/" target="_blank" rel="noopener noreferrer">
      <span class="delivery-icon">✈</span>
      <span>개인통관고유부호 발급 바로가기<br>관세청 개인통관고유부호 사이트에서 발급 신청이 가능합니다.</span>
    </a>
  </footer>

  <button class="back-to-top" type="button" aria-label="맨 위로">↑</button>
  <script>
    const topButton = document.querySelector('.back-to-top');
    function toggleTopButton() {
      topButton.classList.toggle('show', window.scrollY > 420);
    }
    window.addEventListener('scroll', toggleTopButton, { passive: true });
    toggleTopButton();
    topButton.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));
  </script>
</body>
</html>
