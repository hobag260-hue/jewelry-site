<!doctype html>
<html lang="ko" class="<%= (category !== '전체' || brand !== '전체' || q) ? 'scroll-to-products' : '' %>">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>주얼리 쇼케이스</title>
  <link rel="stylesheet" href="/public/style.css">
</head>
<body class="home-page">
  <header class="hero">
    <nav>
      <div class="brand">DOUBLE-ONE JEWELRY</div>
      <form class="top-search" action="/#brand-filter" method="get">
        <input type="hidden" name="category" value="<%= category %>">
        <input type="hidden" name="brand" value="<%= brand %>">
        <input type="hidden" name="section" value="<%= section %>">
        <input name="q" value="<%= q %>" placeholder="상품 검색">
        <button type="submit">검색</button>
      </form>

    </nav>

  </header>

  <div class="main-menu">
    <a href="/">HOME</a>
    <a href="#category-filter">쇼핑하기</a>
    <a href="/company">회사소개</a>
    <a href="/notice">공지사항</a>
    <a href="<%= store.liveLink || '#' %>" <%= store.liveLink ? 'target="_blank" rel="noopener noreferrer"' : '' %>>라이브</a>
  </div>

  <% const bannerImages = (store.banners && store.banners.length) ? store.banners : store.items.slice(0, 6).map(item => item.coverImage || item.image).filter(Boolean); %>
  <% if (bannerImages.length) { %>
    <section class="hero-slider" aria-label="메인 배너">
      <% bannerImages.slice(0, 6).forEach((banner, index) => { %>
        <img class="slider-image <%= index === 0 ? 'active' : '' %>" src="<%= banner %>" alt="DOUBLE-ONE JEWELRY 배너 <%= index + 1 %>">
      <% }) %>
    </section>
  <% } else { %>
    <section class="hero-slider placeholder-slider" aria-label="메인 배너">
      <div>DOUBLE-ONE JEWELRY</div>
    </section>
  <% } %>

  <main class="container" id="products">
    <div class="filter-group" id="category-filter">
      <p>카테고리</p>
      <div class="filters">
        <a class="<%= category === '전체' && brand === '전체' && section === '전체' && !q ? 'active' : '' %>" href="/">HOME</a>
        <a class="<%= category === '전체' ? 'active' : '' %>" href="/?brand=<%= encodeURIComponent(brand) %>&q=<%= encodeURIComponent(q) %>">전체 (<%= categoryCounts['전체'] || 0 %>)</a>
        <% store.categories.forEach(cat => { %>
          <a class="<%= category === cat ? 'active' : '' %>" href="/?category=<%= encodeURIComponent(cat) %>&brand=<%= encodeURIComponent(brand) %>&q=<%= encodeURIComponent(q) %>"><%= cat %> (<%= categoryCounts[cat] || 0 %>)</a>
        <% }) %>
      </div>
    </div>

    <% const brandOptions = category === '전체' ? [...new Set(Object.values(store.subcategories).flat())] : (store.subcategories[category] || []); %>
    <div class="filter-group brand-filter-group" id="brand-filter">
      <p>브랜드</p>
      <div class="filters brand-filters">
        <a class="brand-card <%= brand === '전체' ? 'active' : '' %>" href="/?category=<%= encodeURIComponent(category) %>&q=<%= encodeURIComponent(q) %>">
          <strong>전체 (<%= brandCounts['전체'] || 0 %>)</strong>
        </a>
        <% brandOptions.forEach(option => { %>
          <a class="brand-card <%= brand === option ? 'active' : '' %>" href="/?category=<%= encodeURIComponent(category) %>&brand=<%= encodeURIComponent(option) %>&q=<%= encodeURIComponent(q) %>">
            <strong><%= option %> (<%= brandCounts[option] || 0 %>)</strong>
          </a>
        <% }) %>
      </div>
    </div>

    <% if (items.length === 0) { %>
      <div class="empty">검색된 상품이 없습니다.</div>
    <% } %>

    <section class="grid <%= section !== '전체' ? 'featured-grid' : '' %>">
      <% items.forEach(item => { %>
        <a class="card product-card <%= section !== '전체' ? 'featured-card' : '' %>" href="/item/<%= item.id %>">
          <img src="<%= item.coverImage || item.image %>" loading="lazy" decoding="async" alt="<%= item.title %>">
          <div class="card-body">
            <h2><%= item.title %></h2>
            <% if (section !== '전체') { %>
              <% if (item.description) { %><p><%= item.description %></p><% } %>
            <% } %>
          </div>
        </a>
      <% }) %>
    </section>

    <% if (totalPages > 1) { %>
      <nav class="pagination" aria-label="상품 페이지 이동">
        <% for (let p = 1; p <= totalPages; p += 1) { %>
          <a
            class="pagination-link <%= p === page ? 'active' : '' %>"
            href="/?category=<%= encodeURIComponent(category) %>&brand=<%= encodeURIComponent(brand) %>&section=<%= encodeURIComponent(section) %>&q=<%= encodeURIComponent(q) %>&page=<%= p %>#category-filter"
          ><%= p %></a>
        <% } %>
        <% if (page < totalPages) { %>
          <a class="pagination-next" href="/?category=<%= encodeURIComponent(category) %>&brand=<%= encodeURIComponent(brand) %>&section=<%= encodeURIComponent(section) %>&q=<%= encodeURIComponent(q) %>&page=<%= page + 1 %>#category-filter" aria-label="다음 페이지">&#187;</a>
        <% } %>
      </nav>
    <% } %>
  </main>

  <footer class="contact-footer">
    <div class="contact-main">
      <img class="kakao-icon" src="/public/kakaotalk.svg" alt="KakaoTalk">
      <a href="/item/1778035383224">가톡문의</a>
    </div>
    <a class="customs-link" href="https://unipass.customs.go.kr/" target="_blank" rel="noopener noreferrer">
      <span class="delivery-icon">✈</span>
      <span>개인통관고유부호 발급 바로가기<br>관세청 개인통관고유부호 사이트에서 발급 신청이 가능합니다.</span>
    </a>
    <div class="company-info" id="company">
      업체명 : 회사명 | 대표 : 대표자명<br>
      상담시간 : 평일 오전 10:00 ~ 오후 10:00시까지<br><br>
      Copyright(C) 회사명 더블원 ALL rights REserved .
    </div>
  </footer>
  <script>
    const slides = Array.from(document.querySelectorAll('.slider-image'));
    let slideIndex = 0;
    if (slides.length > 1) {
      setInterval(() => {
        slides[slideIndex].classList.remove('active');
        slideIndex = (slideIndex + 1) % slides.length;
        slides[slideIndex].classList.add('active');
      }, 3500);
    }

    async function updateProducts(url, scrollTarget = null) {
      const currentScroll = window.scrollY;
      const response = await fetch(url.pathname + url.search);
      const html = await response.text();
      const doc = new DOMParser().parseFromString(html, 'text/html');
      const nextProducts = doc.querySelector('#products');
      const currentProducts = document.querySelector('#products');

      if (nextProducts && currentProducts) {
        currentProducts.innerHTML = nextProducts.innerHTML;
        history.replaceState(null, '', url.pathname + url.search);

        const nextSearch = doc.querySelector('.top-search input[name="q"]');
        const currentSearch = document.querySelector('.top-search input[name="q"]');
        if (nextSearch && currentSearch) currentSearch.value = nextSearch.value;

        document.querySelector('.top-search input[name="category"]')?.setAttribute('value', new URLSearchParams(url.search).get('category') || '전체');
        document.querySelector('.top-search input[name="brand"]')?.setAttribute('value', new URLSearchParams(url.search).get('brand') || '전체');
        document.querySelector('.top-search input[name="section"]')?.setAttribute('value', new URLSearchParams(url.search).get('section') || '전체');

        if (scrollTarget) {
          document.querySelector(scrollTarget)?.scrollIntoView({ block: 'start' });
        } else {
          requestAnimationFrame(() => window.scrollTo(0, currentScroll));
        }
      }
    }

    document.addEventListener('click', async event => {
      const link = event.target.closest('.filters a, .section-tabs a, .pagination a');
      if (!link) return;

      event.preventDefault();
      const url = new URL(link.href);
      const shouldScrollToCategory = link.matches('.pagination a');
      await updateProducts(url, shouldScrollToCategory ? '#category-filter' : null);
    });

    document.querySelector('.top-search')?.addEventListener('submit', async event => {
      event.preventDefault();
      const form = event.currentTarget;
      const url = new URL(form.action);
      new FormData(form).forEach((value, key) => url.searchParams.set(key, value));
      url.searchParams.delete('page');
      await updateProducts(url, '#brand-filter');
    });
  </script>
</body>
</html>
